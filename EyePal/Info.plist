<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>com.eyepal.deep-links</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>eyepal</string>
            </array>
        </dict>
    </array>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSCameraUsageDescription</key>
    <string>EyePal uses the camera to read text aloud and recognize familiar faces on-device.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>EyePal uses your location to focus the nearest intersection and monitor altitude for floor detection.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>EyePal uses location in the background to provide continuous spatial awareness, guided routes, markers, and beacon alerts.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>EyePal speaks recognized text and names for accessibility.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>EyePal uses the microphone for low-latency voice chat and live translation.</string>
    <key>NSMotionUsageDescription</key>
    <string>EyePal uses motion data from your device to track heading and orientation for accurate spatial audio and navigation.</string>
    <key>NSSiriUsageDescription</key>
    <string>EyePal uses Siri Shortcuts so you can quickly trigger navigation actions hands-free.</string>
    <key>NSUserActivityTypes</key>
    <array>
        <string>com.eyepal.activity.my-location</string>
        <string>com.eyepal.activity.around-me</string>
        <string>com.eyepal.activity.ahead-of-me</string>
        <string>com.eyepal.activity.nearby-markers</string>
        <string>com.eyepal.activity.search</string>
        <string>com.eyepal.activity.street-preview</string>
        <string>com.eyepal.activity.save-marker</string>
    </array>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>location</string>
    </array>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>UILaunchScreen</key>
    <dict/>
</dict>
</plist>
